[Desktop Entry]
Type=Application
Version=1.5
Name=Panora
GenericName=Clipboard Manager
GenericName[tr]=Pano Yöneticisi
Comment=Search and restore your clipboard history
Comment[tr]=Pano geçmişini ara ve geri çağır
Exec=panora-gui
Icon=io.github.ygkali.Panora
Terminal=false
Categories=Utility;GTK;
Keywords=clipboard;history;paste;
Keywords[tr]=pano;gecmis;kopyala;yapistir;
# A second activation toggles the running popup instead of opening another
# window; D-Bus activation lets panod and the GNOME extension trigger it.
DBusActivatable=true
StartupNotify=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
