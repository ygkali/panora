msgstr "Metin okunduktan sonra uygulanır; yukarıdaki uygulama listesine daha önce bakılır"

msgctxt "settings_min_text_length"
msgid "Minimum text length"
msgstr "En kısa metin"

msgctxt "settings_min_text_length_sub"
msgid "Shorter text is not recorded (characters)"
msgstr "Bundan kısa metin kaydedilmez (karakter)"

msgctxt "settings_ignore_whitespace"
msgid "Skip whitespace-only text"
msgstr "Yalnızca boşluktan oluşan metni atla"

msgctxt "settings_index_full_text"
msgid "Search the whole text"
msgstr "Metnin tamamında ara"

msgctxt "settings_index_full_text_sub"
msgid "Text beyond the 500-character preview is indexed too (kept in the history database)"
msgstr "500 karakterlik önizlemenin ötesi de dizinlenir (geçmiş veritabanında saklanır)"

msgctxt "settings_capture_kinds"
msgid "Recorded kinds"
msgstr "Kaydedilen türler"

msgctxt "settings_capture_kinds_sub"
msgid "A kind that is switched off is never recorded"
msgstr "Kapatılan tür hiç kaydedilmez"

msgctxt "settings_ignore_patterns"
msgid "Ignore patterns"
msgstr "Yoksayma kalıpları"

msgctxt "settings_ignore_patterns_sub"
msgid "Regular expressions; matching text is not recorded (e.g. ^\\d{16}$ for a 16-digit card number)"
msgstr "Düzenli ifadeler; eşleşen metin kaydedilmez (örn. 16 haneli kart numarası için ^\\d{16}$)"

msgctxt "settings_ignore_pattern_placeholder"
msgid "regular expression"
msgstr "düzenli ifade"

#. Tooltip on the pattern entry once a pattern failed to compile.
msgctxt "settings_ignore_pattern_invalid"
msgid "Not a valid regular expression"
msgstr "Geçerli bir düzenli ifade değil"

msgctxt "settings_excluded_titles"
msgid "Excluded window titles"
msgstr "Hariç tutulan pencere başlıkları"

msgctxt "settings_excluded_titles_sub"
msgid "Nothing is recorded while the focused window's title contains one of these (X11 and GNOME); the title is not stored"
msgstr "Odaktaki pencerenin başlığı bunlardan birini içerirken hiçbir şey kaydedilmez (X11 ve GNOME); başlık saklanmaz"

msgctxt "settings_excluded_title_placeholder"
msgid "part of a title (e.g. Online Banking)"
msgstr "başlığın bir parçası (örn. İnternet Bankacılığı)"

#. Tooltip of the lock icon on a flagged row.
msgctxt "sensitive_label"
msgid "Sensitive content: removed when its time is up"
msgstr "Hassas içerik: süresi dolunca silinir"

msgctxt "details_sensitive_note"
msgid "Looks like a key, token or card/account number: masked in the list and removed after the configured time."
msgstr "Gizli anahtar, jeton ya da kart/hesap numarasına benziyor: listede maskelenir ve ayarlanan süre sonunda silinir."

msgctxt "settings_sensitive_policy"
msgid "Secrets and card numbers"
msgstr "Gizli anahtarlar ve kart numaraları"

msgctxt "settings_sensitive_policy_sub"
msgid "What happens to text that looks like an API key, token, card or IBAN"
msgstr "API anahtarı, jeton, kart ya da IBAN'a benzeyen metne ne yapılır"

msgctxt "settings_sensitive_mask"
msgid "Record, mask the preview"
msgstr "Kaydet, önizlemeyi maskele"

msgctxt "settings_sensitive_drop"
msgid "Do not record"
msgstr "Kaydetme"

msgctxt "settings_sensitive_store"
msgid "Record like anything else"
msgstr "Diğerleri gibi kaydet"

msgctxt "settings_sensitive_ttl"
msgid "Remove after (minutes)"
msgstr "Şu kadar dakika sonra sil"

msgctxt "settings_sensitive_ttl_sub"
msgid "0 keeps them like other entries; pinned entries stay either way"
msgstr "0 = diğer kayıtlar gibi tutulur; sabitlenenler her durumda kalır"

msgctxt "settings_system"
msgid "System"
msgstr "Sistem"

msgctxt "settings_autostart"
msgid "Start with the session"
msgstr "Oturumla birlikte başlat"

msgctxt "settings_autostart_sub"
