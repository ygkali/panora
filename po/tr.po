msgid "Save"
msgstr "Kaydet"

msgctxt "shortcuts_title"
msgid "Keyboard shortcuts"
msgstr "Klavye kısayolları"

msgctxt "shortcuts_body"
msgid "Ctrl+F  ·  focus search\n↑ ↓ ← →  ·  move between items\nHome / End / PgUp / PgDn  ·  jump in the list\nEnter  ·  put the selected item on the clipboard\nShift+Enter  ·  put only its plain text on the clipboard\nCtrl+1…9  ·  put the Nth item on the clipboard\nSpace  ·  open the selected item's details\nCtrl+D  ·  pin / unpin the selected item\nDelete  ·  delete the selected item (undo from the toast)\nCtrl+Shift+P  ·  toggle private mode\nCtrl+,  ·  settings\nEsc  ·  clear the search / close the window\nAny letter  ·  start searching"
msgstr "Ctrl+F  ·  aramaya git\n↑ ↓ ← →  ·  kayıtlar arasında gez\nHome / End / PgUp / PgDn  ·  listede atla\nEnter  ·  seçili kaydı panoya koy\nShift+Enter  ·  yalnızca düz metnini panoya koy\nCtrl+1…9  ·  listedeki N. kaydı panoya koy\nSpace  ·  seçili kaydın ayrıntısını aç\nCtrl+D  ·  seçili kaydı sabitle / çöz\nDelete  ·  seçili kaydı sil (geri alınabilir)\nCtrl+Shift+P  ·  özel modu aç / kapat\nCtrl+,  ·  ayarlar\nEsc  ·  aramayı temizle / pencereyi kapat\nHerhangi bir harf  ·  aramaya başla"

