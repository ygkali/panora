msgctxt "settings_theme_dark"
msgid "Dark"
msgstr "Koyu"

msgctxt "settings_instant_paste"
msgid "Instant paste"
msgstr "Anında yapıştır"

msgctxt "settings_instant_paste_sub"
msgid "Send Ctrl+V (Ctrl+Shift+V in terminals) to the focused window after picking an item"
msgstr "Kayıt seçilince odaktaki pencereye Ctrl+V (terminallerde Ctrl+Shift+V) gönder"

msgctxt "settings_close_on_focus_loss"
msgid "Close when focus leaves"
msgstr "Odak kaybında kapat"

msgctxt "settings_close_on_focus_loss_sub"
msgid "The panel closes when you switch to another window (like Win+V)"
msgstr "Başka bir pencereye geçilince panel kapanır (Win+V gibi)"

msgctxt "settings_position"
msgid "Panel position"
msgstr "Panel konumu"

msgctxt "settings_position_sub"
msgid "Where the panel opens on X11 and GNOME; Sway/Hyprland use ui.layer_anchor"
msgstr "X11 ve GNOME'da panelin açıldığı yer; Sway/Hyprland ui.layer_anchor ayarını kullanır"

msgctxt "settings_position_pointer"
msgid "Next to the pointer"
msgstr "İşaretçinin yanında"

msgctxt "settings_position_center"
msgid "Centre of the screen"
msgstr "Ekranın ortasında"

msgctxt "settings_filters"
msgid "Content filters"
msgstr "İçerik filtreleri"

msgctxt "settings_filters_sub"
msgid "Applied once the text has been read; the application list above is checked first"
msgstr "Metin okunduktan sonra uygulanır; yukarıdaki uygulama listesine daha önce bakılır"

msgctxt "settings_min_text_length"
msgid "Minimum text length"
msgstr "En kısa metin"

msgctxt "settings_min_text_length_sub"
msgid "Shorter text is not recorded (characters)"
msgstr "Bundan kısa metin kaydedilmez (karakter)"

msgctxt "settings_ignore_whitespace"
msgid "Skip whitespace-only text"
msgstr "Yalnızca boşluktan oluşan metni atla"

msgctxt "settings_index_full_text"
msgid "Search the whole text"
msgstr "Metnin tamamında ara"

msgctxt "settings_index_full_text_sub"
msgid "Text beyond the 500-character preview is indexed too (kept in the history database)"
msgstr "500 karakterlik önizlemenin ötesi de dizinlenir (geçmiş veritabanında saklanır)"

msgctxt "settings_capture_kinds"
msgid "Recorded kinds"
msgstr "Kaydedilen türler"

msgctxt "settings_capture_kinds_sub"
msgid "A kind that is switched off is never recorded"
msgstr "Kapatılan tür hiç kaydedilmez"

msgctxt "settings_ignore_patterns"
msgid "Ignore patterns"
msgstr "Yoksayma kalıpları"

msgctxt "settings_ignore_patterns_sub"
msgid "Regular expressions; matching text is not recorded (e.g. ^\\d{16}$ for a 16-digit card number)"
msgstr "Düzenli ifadeler; eşleşen metin kaydedilmez (örn. 16 haneli kart numarası için ^\\d{16}$)"

msgctxt "settings_ignore_pattern_placeholder"
msgid "regular expression"
msgstr "düzenli ifade"

#. Tooltip on the pattern entry once a pattern failed to compile.
msgctxt "settings_ignore_pattern_invalid"
msgid "Not a valid regular expression"
msgstr "Geçerli bir düzenli ifade değil"

msgctxt "settings_excluded_titles"
msgid "Excluded window titles"
msgstr "Hariç tutulan pencere başlıkları"

msgctxt "settings_excluded_titles_sub"
msgid "Nothing is recorded while the focused window's title contains one of these (X11 and GNOME); the title is not stored"
msgstr "Odaktaki pencerenin başlığı bunlardan birini içerirken hiçbir şey kaydedilmez (X11 ve GNOME); başlık saklanmaz"

msgctxt "settings_excluded_title_placeholder"
msgid "part of a title (e.g. Online Banking)"
msgstr "başlığın bir parçası (örn. İnternet Bankacılığı)"

#. Tooltip of the lock icon on a flagged row.
msgctxt "sensitive_label"
msgid "Sensitive content: removed when its time is up"
msgstr "Hassas içerik: süresi dolunca silinir"

msgctxt "details_sensitive_note"
msgid "Looks like a key, token or card/account number: masked in the list and removed after the configured time."
msgstr "Gizli anahtar, jeton ya da kart/hesap numarasına benziyor: listede maskelenir ve ayarlanan süre sonunda silinir."

msgctxt "settings_sensitive_policy"
msgid "Secrets and card numbers"
msgstr "Gizli anahtarlar ve kart numaraları"

msgctxt "settings_sensitive_policy_sub"
msgid "What happens to text that looks like an API key, token, card or IBAN"
msgstr "API anahtarı, jeton, kart ya da IBAN'a benzeyen metne ne yapılır"

msgctxt "settings_sensitive_mask"
msgid "Record, mask the preview"
msgstr "Kaydet, önizlemeyi maskele"

msgctxt "settings_sensitive_drop"
msgid "Do not record"
msgstr "Kaydetme"

msgctxt "settings_sensitive_store"
msgid "Record like anything else"
msgstr "Diğerleri gibi kaydet"

msgctxt "settings_sensitive_ttl"
msgid "Remove after (minutes)"
msgstr "Şu kadar dakika sonra sil"

msgctxt "settings_sensitive_ttl_sub"
msgid "0 keeps them like other entries; pinned entries stay either way"
msgstr "0 = diğer kayıtlar gibi tutulur; sabitlenenler her durumda kalır"

msgctxt "settings_system"
msgid "System"
msgstr "Sistem"

msgctxt "settings_autostart"
msgid "Start with the session"
msgstr "Oturumla birlikte başlat"

msgctxt "settings_autostart_sub"
msgid "The user service that records the clipboard (panod.service)"
msgstr "Panoyu kaydeden kullanıcı servisi (panod.service)"

#. `{e}` = the error text.
msgctxt "settings_autostart_failed"
msgid "Could not change the service: {e}"
msgstr "Servis ayarı değiştirilemedi: {e}"

msgctxt "settings_storage"
msgid "Storage used"
msgstr "Kullanılan alan"

msgctxt "settings_storage_sub"
msgid "History database and encrypted payloads"
msgstr "Geçmiş veritabanı ve şifreli içerikler"

msgctxt "welcome_title"
msgid "Welcome to Panora"
msgstr "Panora'ya hoş geldiniz"

msgctxt "welcome_shortcut_title"
msgid "Super+V"
msgstr "Super+V"

msgctxt "welcome_shortcut_body"
msgid "Opens the history from anywhere. Enter puts the selected entry on the clipboard, Shift+Enter only its plain text, Ctrl+1…9 pick the first rows."
msgstr "Geçmişi her yerden açar. Enter seçili kaydı panoya koyar, Shift+Enter yalnızca düz metni, Ctrl+1…9 ilk satırları seçer."

msgctxt "welcome_privacy_title"
msgid "Your clipboard stays yours"
msgstr "Panonuz size ait"

msgctxt "welcome_privacy_body"
msgid "Everything is encrypted with a key kept in your login keyring. Password managers are never read, secrets are masked and expire, and private mode pauses recording."
msgstr "Her şey giriş anahtarlığınızdaki bir anahtarla şifrelenir. Parola yöneticileri hiç okunmaz, gizli anahtarlar maskelenir ve süresi dolunca silinir, özel mod kaydı durdurur."

msgctxt "welcome_session_title"
msgid "This session"
msgstr "Bu oturum"

msgctxt "welcome_session_all_good"
msgid "Everything works here: capture, instant paste and the source application are all available."
msgstr "Burada her şey çalışır: yakalama, anında yapıştırma ve kaynak uygulama bilgisi kullanılabilir."

msgctxt "welcome_session_bridge"
msgid "GNOME on Wayland: capture goes through the Panora Shell extension, which must be enabled."
msgstr "Wayland üzerinde GNOME: yakalama Panora Shell eklentisi üzerinden yapılır; eklenti etkin olmalı."

msgctxt "welcome_session_no_source_app"
msgid "This compositor does not name the copying application, so the excluded-applications list cannot apply here."
msgstr "Bu bileşim yöneticisi kopyalayan uygulamayı bildirmez; hariç tutulan uygulamalar listesi burada işlemez."

msgctxt "welcome_session_no_paste"
msgid "Instant paste is not available here; entries are put on the clipboard for you to paste."
msgstr "Anında yapıştırma burada yok; kayıtlar panoya konur, yapıştırmak size kalır."

msgctxt "welcome_session_unknown"
msgid "The daemon is not reachable yet; run panora-doctor if this persists."
msgstr "Daemon'a henüz ulaşılamıyor; sürerse panora-doctor çalıştırın."

msgctxt "welcome_next"
msgid "Next"
msgstr "İleri"

msgctxt "welcome_done"
msgid "Get started"
msgstr "Başla"

msgctxt "details_open_link"
msgid "Open in browser"
msgstr "Tarayıcıda aç"

msgctxt "details_show_qr"
