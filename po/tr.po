msgid "Excluded applications"
msgstr "Hariç tutulan uygulamalar"

msgctxt "settings_excluded_apps_sub"
msgid "Copies from these apps are never read"
msgstr "Bu uygulamalardan kopyalananlar hiç okunmaz"

msgctxt "settings_excluded_add_placeholder"
msgid "application name (e.g. keepassxc)"
msgstr "uygulama adı (örn. keepassxc)"

msgctxt "settings_excluded_add"
msgid "Add"
msgstr "Ekle"

msgctxt "settings_excluded_remove"
msgid "Remove"
msgstr "Kaldır"

#. Shown when the active backend cannot name the source application, so
#. the exclusion list above has nothing to match against.
msgctxt "settings_excluded_unsupported"
msgid "Inactive in this session: the Wayland data-control protocol does not report which application made the copy. Content a password manager flags as secret is still blocked."
msgstr "Bu oturumda çalışmaz: Wayland data-control protokolü kopyalayan uygulamanın kimliğini bildirmiyor. Parola yöneticilerinin gizli içerik işaretleri yine de engellenir."

