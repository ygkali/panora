#!/usr/bin/env bash
# Copyright (C) 2026 Panora contributors
# SPDX-License-Identifier: GPL-3.0-only
#
# panora-doctor: read-only diagnostics for an installed Panora.
#
# Prints one line per check (OK / WARN / ERROR / INFO) with a fix hint for
# anything that is not OK. Exit status is 0 unless the daemon itself is
# unusable (panod not running or `panora-cli status` failing); warnings never
# change the exit status. `--json` prints the same checks as a JSON document.
#
# The script never modifies anything: no config writes, no service restarts,
# no package installs. Every hint is a command the user can run by hand.
#
# Messages are English; Turkish is used when the locale (LANG, LC_ALL or
# PANORA_LANG) starts with "tr". Status labels and JSON keys never change.
set -Eeuo pipefail

APP_ID="io.github.ygkali.Panora"
BRIDGE_NAME="io.github.ygkali.Panora.GnomeBridge1"
HELPER_NAME="io.github.ygkali.Panora.GnomeShell1"
EXT_UUID="panora@ygkali.github.io"

# ------------------------------------------------------------------ messages

