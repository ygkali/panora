ui_lang() {
  local l="${PANORA_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}"
  case "${l,,}" in tr*) echo tr ;; *) echo en ;; esac
}
UI_LANG="$(ui_lang)"
# t FORMAT [ARGS...] -> translated, printf-formatted text without newline.
t() {
  local fmt="$1"
  shift
  if [[ "$UI_LANG" == tr && -n "${TR[$fmt]+x}" ]]; then
    fmt="${TR[$fmt]}"
  fi
  # shellcheck disable=SC2059
  printf -- "$fmt" "$@"
}
say() { t "$@"; printf '\n'; }

JSON=0
for arg in "$@"; do
  case "$arg" in
    --json) JSON=1 ;;
    -h|--help)
      say "Usage: panora-doctor [--json]"
      echo
      say "Checks an installed Panora: operating system, session type, binaries,"
      say "panod.service, IPC socket, backend, GNOME extension, D-Bus names, Secret"
      say "Service, Super+V conflicts, data directory and configuration."
      echo
      say "The exit status is 1 only when the daemon is unusable; warnings do not"
      say "change it."
      exit 0 ;;
    *) say "panora-doctor: unknown option: %s" "$arg" >&2; exit 2 ;;
  esac
done

# ------------------------------------------------------------------ output

# Set to 1 when the daemon cannot serve clients; drives the exit status.
DAEMON_UNUSABLE=0
COUNT_OK=0
COUNT_WARN=0
COUNT_ERR=0
JSON_ITEMS=()

# Escape a string for a JSON string literal.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/}"
  printf '%s' "$s"
}

# check STATUS NAME RESULT [HINT]
#   STATUS: OK | WARN | ERROR | INFO
check() {
  local status="$1" name="$2" result="$3" hint="${4:-}"
  case "$status" in
    OK) COUNT_OK=$((COUNT_OK + 1)) ;;
    WARN) COUNT_WARN=$((COUNT_WARN + 1)) ;;
    ERROR) COUNT_ERR=$((COUNT_ERR + 1)) ;;
  esac
  if [[ "$JSON" -eq 1 ]]; then
    JSON_ITEMS+=("{\"status\":\"$status\",\"check\":\"$(json_escape "$name")\",\"result\":\"$(json_escape "$result")\",\"hint\":\"$(json_escape "$hint")\"}")
    return
  fi
  # bash's printf pads by bytes, so pad non-ASCII names by character count.
  local pad=$((30 - ${#name}))
  [[ "$pad" -lt 1 ]] && pad=1
  printf '%-6s %s%*s%s\n' "$status" "$name" "$pad" "" "$result"
  if [[ -n "$hint" && "$status" != "OK" ]]; then
    # Multi-line hints (journal excerpts) are indented as a block.
    while IFS= read -r line; do
      printf '       -> %s\n' "$line"
    done <<<"$hint"
  fi
}

section() {
  [[ "$JSON" -eq 1 ]] && return
  printf '\n%s\n' "$(t "$1")"
}

# Run a command with a time limit so a hung daemon or bus never hangs us.
with_timeout() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 8 "$@"
  else
    "$@"
  fi
}

has() { command -v "$1" >/dev/null 2>&1; }

# ------------------------------------------------------------- bus helpers

# bus_has_name NAME -> 0 when NAME currently has an owner on the session bus.
bus_has_name() {
  local name="$1" out
  if has gdbus; then
    out="$(with_timeout gdbus call --session --dest org.freedesktop.DBus \
      --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.NameHasOwner "$name" 2>/dev/null || true)"
    [[ "$out" == *true* ]]
    return
  fi
  if has busctl; then
    with_timeout busctl --user list --acquired --no-legend 2>/dev/null |
      awk '{print $1}' | grep -qx -- "$name"
    return
  fi
  return 2
}

# bus_activatable NAME -> 0 when NAME has a D-Bus service file (starts on demand).
bus_activatable() {
  local name="$1" out
  if has gdbus; then
    out="$(with_timeout gdbus call --session --dest org.freedesktop.DBus \
      --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.ListActivatableNames 2>/dev/null || true)"
    [[ "$out" == *"'$name'"* ]]
    return
  fi
  if has busctl; then
    with_timeout busctl --user list --activatable --no-legend 2>/dev/null |
      awk '{print $1}' | grep -qx -- "$name"
    return
  fi
  return 2
}

# --------------------------------------------------------------- 1. system

section "System"

OS_NAME="$(t "unknown")"
OS_ID=""
OS_LIKE=""
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  OS_NAME="$(. /etc/os-release && printf '%s' "${PRETTY_NAME:-$NAME}")"
  OS_ID="$(. /etc/os-release && printf '%s' "${ID:-}")"
  OS_LIKE="$(. /etc/os-release && printf '%s' "${ID_LIKE:-}")"
fi
if [[ "$OS_ID $OS_LIKE" == *debian* || "$OS_ID $OS_LIKE" == *ubuntu* ]]; then
  check OK "$(t "Operating system")" "$OS_NAME"
else
  check WARN "$(t "Operating system")" "$OS_NAME" \
    "$(t "The package is tested on Debian/Ubuntu based systems; see 'Building from source' in README.md.")"
fi

SESSION="${XDG_SESSION_TYPE:-}"
case "$SESSION" in
  x11|wayland) check OK "$(t "Session type")" "$SESSION" ;;
  "") check WARN "$(t "Session type")" "$(t "XDG_SESSION_TYPE is unset")" \
        "$(t "Run this from a terminal inside the graphical session (not over SSH).")" ;;
  *) check WARN "$(t "Session type")" "$SESSION" "$(t "expected a graphical session (x11/wayland).")" ;;
esac

DESKTOP="${XDG_CURRENT_DESKTOP:-}"
IS_GNOME=0
if [[ "${DESKTOP,,}" == *gnome* ]] || bus_has_name org.gnome.Shell 2>/dev/null; then
  IS_GNOME=1
fi
DESKTOP_NOTE=""
[[ "$IS_GNOME" -eq 1 ]] && DESKTOP_NOTE="$(t " (GNOME Shell is running)")"
check INFO "$(t "Desktop")" "${DESKTOP:-$(t "unknown")}$DESKTOP_NOTE"

SHELL_MAJOR=0
if has gnome-shell; then
  SHELL_VER="$(with_timeout gnome-shell --version 2>/dev/null | sed 's/^GNOME Shell //' || true)"
  SHELL_MAJOR="${SHELL_VER%%.*}"
  [[ "$SHELL_MAJOR" =~ ^[0-9]+$ ]] || SHELL_MAJOR=0
  if [[ "$SESSION" == "wayland" && "$SHELL_MAJOR" -gt 0 && "$SHELL_MAJOR" -lt 48 ]]; then
    check INFO "$(t "gnome-shell version")" "$(t "%s (on Wayland, capture goes through the Shell extension)" "${SHELL_VER:-?}")"
  else
    check INFO "$(t "gnome-shell version")" "${SHELL_VER:-?}"
  fi
else
  check INFO "$(t "gnome-shell version")" "$(t "no gnome-shell (non-GNOME desktop)")"
fi

# -------------------------------------------------------------- 2. binaries

section "Installation"

PKG_VER="$(dpkg-query -W -f='${Version}' panora 2>/dev/null || true)"
if [[ -n "$PKG_VER" ]]; then
  check OK "$(t "panora package")" "$(t "version %s (dpkg)" "$PKG_VER")"
else
  check WARN "$(t "panora package")" "$(t "no dpkg record")" \
    "$(t "The package is not installed or Panora runs from a source build: ./install.sh")"
fi

MISSING_BIN=()
for bin in panod panora-gui panora-cli panora panora-doctor; do
  if [[ -x "/usr/bin/$bin" ]]; then
    :
  elif has "$bin"; then
    check WARN "/usr/bin/$bin" "$(t "missing; on PATH: %s" "$(command -v "$bin")")" \
      "$(t "A source build is in use instead of the package; Super+V and D-Bus activation expect /usr/bin.")"
  else
    MISSING_BIN+=("$bin")
  fi
done
if [[ ${#MISSING_BIN[@]} -eq 0 ]]; then
  check OK "$(t "Binaries")" "$(t "panod, panora-gui, panora-cli, panora, panora-doctor present")"
else
  check ERROR "$(t "Binaries")" "$(t "missing: %s" "${MISSING_BIN[*]}")" "$(t "./install.sh   (or sudo dpkg -i dist/panora_*.deb)")"
  if [[ " ${MISSING_BIN[*]} " == *" panora-cli "* || " ${MISSING_BIN[*]} " == *" panod "* ]]; then
    DAEMON_UNUSABLE=1
  fi
fi

for f in "/usr/share/dbus-1/services/$APP_ID.service" \
         "/usr/share/applications/$APP_ID.desktop" \
         /usr/lib/systemd/user/panod.service; do
  if [[ -f "$f" ]]; then
    check OK "$(basename "$f")" "$f"
  else
    case "$f" in
      *dbus-1*) hint="$(t "The popup cannot be D-Bus activated; Super+V and 'panora-cli toggle' start panora-gui directly. Reinstall the package.")" ;;
      *applications*) hint="$(t "Panora will not show up in the application menu. Reinstall the package.")" ;;
      *) hint="$(t "systemd unit missing: reinstall the package (./install.sh).")" ;;
    esac
    check WARN "$(basename "$f")" "$(t "missing")" "$hint"
  fi
done

# ---------------------------------------------------------------- 3. daemon

section "Daemon"

UNIT_ACTIVE="$(t "unknown")"
if has systemctl; then
  UNIT_ENABLED="$(with_timeout systemctl --user is-enabled panod.service 2>/dev/null || true)"
  UNIT_ACTIVE="$(with_timeout systemctl --user is-active panod.service 2>/dev/null || true)"
  UNIT_ENABLED="${UNIT_ENABLED:-$(t "unknown")}"
  UNIT_ACTIVE="${UNIT_ACTIVE:-$(t "unknown")}"
  if [[ "$UNIT_ACTIVE" == "active" ]]; then
    if [[ "$UNIT_ENABLED" == "enabled" ]]; then
      check OK "panod.service" "$(t "active, enabled")"
    else
      check WARN "panod.service" "$(t "active, %s" "$UNIT_ENABLED")" \
        "$(t "The service will not start at login: systemctl --user enable panod.service")"
    fi
  else
    DAEMON_UNUSABLE=1
    JOURNAL="$(with_timeout journalctl --user -u panod.service -n 20 --no-pager -o short 2>/dev/null || true)"
    HINT="systemctl --user enable --now panod.service"
    if [[ "$UNIT_ACTIVE" == "failed" ]]; then
      HINT="systemctl --user reset-failed panod.service && systemctl --user restart panod.service"
    fi
    if [[ -n "$JOURNAL" ]]; then
      HINT="$HINT"$'\n'"$(t "Last 20 journal lines (journalctl --user -u panod.service -n 20):")"$'\n'"$JOURNAL"
    fi
    check ERROR "panod.service" "$UNIT_ACTIVE, $UNIT_ENABLED" "$HINT"
  fi
else
  check WARN "panod.service" "$(t "no systemctl")" "$(t "Start panod by hand: panod &")"
fi

SOCK="${XDG_RUNTIME_DIR:-$HOME/.local/share/panora}/panora.sock"
if [[ -S "$SOCK" ]]; then
  MODE="$(stat -c '%a' "$SOCK" 2>/dev/null || true)"
  OWNER="$(stat -c '%u' "$SOCK" 2>/dev/null || true)"
  if [[ "$MODE" == "600" && "$OWNER" == "$(id -u)" ]]; then
    check OK "$(t "IPC socket")" "$(t "%s (0600, uid %s)" "$SOCK" "$OWNER")"
  else
    check WARN "$(t "IPC socket")" "$(t "%s mode=%s owner=%s" "$SOCK" "$MODE" "$OWNER")" \
      "$(t "The socket must be 0600 and owned by you; restart panod: systemctl --user restart panod.service")"
  fi
else
  if [[ "$UNIT_ACTIVE" == "active" ]]; then
    check ERROR "$(t "IPC socket")" "$(t "%s is missing" "$SOCK")" \
      "$(t "The service is running but there is no socket; XDG_RUNTIME_DIR may differ. journalctl --user -u panod.service -n 50")"
    DAEMON_UNUSABLE=1
  else
    check ERROR "$(t "IPC socket")" "$(t "%s is missing" "$SOCK")" "$(t "The daemon is not running (see above).")"
  fi
fi

STATUS_LINE=""
BACKEND=""
PRIVATE=""
if has panora-cli; then
  if STATUS_LINE="$(with_timeout panora-cli status 2>&1)"; then
    BACKEND="$(sed -n 's/.*backend=\([^ ]*\).*/\1/p' <<<"$STATUS_LINE")"
    PRIVATE="$(sed -n 's/.*private=\([^ ]*\).*/\1/p' <<<"$STATUS_LINE")"
    ENTRIES="$(sed -n 's/.*entries=\([^ ]*\).*/\1/p' <<<"$STATUS_LINE")"
    DVER="$(sed -n 's/.*version=\([^ ]*\).*/\1/p' <<<"$STATUS_LINE")"
    check OK "panora-cli status" "$(t "backend=%s entries=%s version=%s" "${BACKEND:-?}" "${ENTRIES:-?}" "${DVER:-?}")"
    case "$BACKEND" in
      x11)
        if [[ "$SESSION" == "wayland" ]]; then
          check WARN "$(t "Backend")" "$(t "x11 (fallback through XWayland)")" \
            "$(t "Source application names are unknown on Wayland. Enable the extension on GNOME; other desktops need a data-control protocol.")"
        else
          check OK "$(t "Backend")" "$(t "x11 (XFIXES + native selection owner)")"
        fi ;;
      wayland) check OK "$(t "Backend")" "$(t "wayland (ext/wlr data-control)")" ;;
      gnome-bridge) check OK "$(t "Backend")" "$(t "gnome-bridge (capture through the Shell extension)")" ;;
      "") check WARN "$(t "Backend")" "$(t "could not be read from the status output")" "panora-cli --json status" ;;
      *) check INFO "$(t "Backend")" "$BACKEND" ;;
    esac
    if [[ "$PRIVATE" == "true" ]]; then
      check WARN "$(t "Private mode")" "$(t "on: new copies are not recorded")" "$(t "To turn it off: panora-cli private off")"
    else
      check OK "$(t "Private mode")" "$(t "off")"
    fi
  else
    DAEMON_UNUSABLE=1
    check ERROR "panora-cli status" "${STATUS_LINE:-$(t "no reply")}" \
      "systemctl --user status panod.service && journalctl --user -u panod.service -n 50 --no-pager"
  fi
fi

# --------------------------------------------------------------- 4. GNOME

section "GNOME integration"

EXT_STATE=""
EXT_ENABLED=""
EXT_DIR=""
for d in "/usr/share/gnome-shell/extensions/$EXT_UUID" \
         "${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/$EXT_UUID"; do
  [[ -d "$d" ]] && { EXT_DIR="$d"; break; }
done

if [[ "$IS_GNOME" -eq 1 ]]; then
  if has gnome-extensions; then
    EXT_INFO="$(with_timeout gnome-extensions info "$EXT_UUID" 2>/dev/null || true)"
    EXT_STATE="$(sed -n 's/^ *State: *//p' <<<"$EXT_INFO" | head -n1)"
    EXT_ENABLED="$(sed -n 's/^ *Enabled: *//p' <<<"$EXT_INFO" | head -n1)"
    if [[ -z "$EXT_INFO" ]]; then
      if [[ -n "$EXT_DIR" ]]; then
        check ERROR "$(t "GNOME extension")" "$(t "files present (%s) but gnome-shell does not see them yet" "$EXT_DIR")" \
          "$(t "Log out and back in, then: gnome-extensions enable %s" "$EXT_UUID")"
      else
        check ERROR "$(t "GNOME extension")" "$(t "not installed")" \
          "$(t "Reinstall the package (./install.sh); the extension is written under /usr/share/gnome-shell/extensions.")"
      fi
    elif [[ "$EXT_STATE" == "ACTIVE" ]]; then
      check OK "$(t "GNOME extension")" "$(t "ACTIVE (%s)" "${EXT_DIR:-?}")"
    elif [[ "$EXT_STATE" == "ERROR" ]]; then
      check ERROR "$(t "GNOME extension")" "ERROR" \
        "journalctl --user -b -o cat /usr/bin/gnome-shell | grep -i panora"
    elif [[ "$EXT_ENABLED" == "Yes" ]]; then
      check WARN "$(t "GNOME extension")" "$(t "enabled but state: %s" "${EXT_STATE:-?}")" \
        "$(t "Log out and back in; details: gnome-extensions info %s" "$EXT_UUID")"
    else
      check WARN "$(t "GNOME extension")" "$(t "installed, not enabled (%s)" "${EXT_STATE:-?}")" \
        "gnome-extensions enable $EXT_UUID"
    fi
    if [[ "$BACKEND" == "gnome-bridge" && "$EXT_STATE" != "ACTIVE" ]]; then
      check ERROR "$(t "Clipboard capture")" "$(t "the gnome-bridge backend captures nothing without the extension")" \
        "$(t "gnome-extensions enable %s  (log out and back in if needed)" "$EXT_UUID")"
    fi
  else
    check WARN "$(t "GNOME extension")" "$(t "gnome-extensions tool missing")" "sudo apt install -y gnome-shell-extension-prefs"
  fi
else
  check INFO "$(t "GNOME extension")" "$(t "non-GNOME desktop, skipped")" \
    "$(t "For a shortcut, bind 'panora-cli toggle' to a key in your desktop's settings.")"
fi

# D-Bus names.
if bus_has_name "$BRIDGE_NAME"; then
  check OK "$BRIDGE_NAME" "$(t "on the session bus (panod)")"
else
  rc=$?
  if [[ "$rc" -eq 2 ]]; then
    check WARN "$BRIDGE_NAME" "$(t "could not check (no gdbus/busctl)")" "sudo apt install -y libglib2.0-bin"
  elif [[ "$BACKEND" == "gnome-bridge" ]]; then
    check ERROR "$BRIDGE_NAME" "$(t "not on the bus")" \
      "$(t "panod could not register its D-Bus service; journalctl --user -u panod.service -n 50")"
  else
    check WARN "$BRIDGE_NAME" "$(t "not on the bus")" \
      "$(t "panod is not running or cannot reach the session bus (DBUS_SESSION_BUS_ADDRESS).")"
  fi
fi

if bus_has_name "$HELPER_NAME"; then
  check OK "$HELPER_NAME" "$(t "on the session bus (Shell extension)")"
else
  rc=$?
  if [[ "$rc" -eq 2 ]]; then
    check WARN "$HELPER_NAME" "$(t "could not check (no gdbus/busctl)")" "sudo apt install -y libglib2.0-bin"
  elif [[ "$IS_GNOME" -eq 1 ]]; then
    check WARN "$HELPER_NAME" "$(t "not on the bus")" \
      "$(t "The extension is not enabled or gnome-shell was not restarted: gnome-extensions enable %s" "$EXT_UUID")"
  else
    check INFO "$HELPER_NAME" "$(t "not expected on a non-GNOME desktop")"
  fi
fi

if bus_has_name "$APP_ID"; then
  check INFO "$APP_ID" "$(t "the popup is open right now")"
elif bus_activatable "$APP_ID"; then
  check OK "$APP_ID" "$(t "D-Bus activatable")"
else
  check WARN "$APP_ID" "$(t "not activatable")" \
    "$(t "/usr/share/dbus-1/services/%s.service is missing; reinstall the package." "$APP_ID")"
fi

# Super+V conflicts.
if has gsettings && [[ "$IS_GNOME" -eq 1 ]]; then
  TRAY="$(with_timeout gsettings get org.gnome.shell.keybindings toggle-message-tray 2>/dev/null || true)"
  if [[ "${TRAY,,}" == *"<super>v"* ]]; then
    check WARN "$(t "Super+V conflict")" "toggle-message-tray = $TRAY" \
      "$(t "The GNOME notification list also uses Super+V. Fix: gsettings set org.gnome.shell.keybindings toggle-message-tray \"['<Super>m']\"")"
  elif [[ -n "$TRAY" ]]; then
    check OK "$(t "Super+V conflict")" "toggle-message-tray = $TRAY"
  else
    check INFO "$(t "Super+V conflict")" "$(t "gsettings could not be read")"
  fi
  if [[ -n "$EXT_DIR" && -f "$EXT_DIR/schemas/gschemas.compiled" ]]; then
    POPUP_KEY="$(with_timeout gsettings --schemadir "$EXT_DIR/schemas" get org.gnome.shell.extensions.panora toggle-popup 2>/dev/null || true)"
    check INFO "$(t "Panora shortcut")" "toggle-popup = ${POPUP_KEY:-$(t "unreadable")}"
  elif [[ -n "$EXT_DIR" ]]; then
    check WARN "$(t "Panora shortcut")" "$(t "%s/schemas/gschemas.compiled is missing" "$EXT_DIR")" \
      "$(t "The schema is not compiled; Super+V will not work: sudo glib-compile-schemas %s/schemas" "$EXT_DIR")"
  fi
fi

# -------------------------------------------------------- 5. secret service

section "Keyring and helpers"

if bus_has_name org.freedesktop.secrets; then
  check OK "$(t "Secret Service")" "$(t "org.freedesktop.secrets is running (gnome-keyring)")"
else
  rc=$?
  if [[ "$rc" -eq 2 ]]; then
    check WARN "$(t "Secret Service")" "$(t "could not check (no gdbus/busctl)")" "sudo apt install -y libglib2.0-bin"
  elif bus_activatable org.freedesktop.secrets; then
    check WARN "$(t "Secret Service")" "$(t "installed, not running right now (starts on first request)")" \
      "$(t "If the keyring is locked panod stops after 60 s. After unlocking: systemctl --user restart panod.service")"
  else
    check ERROR "$(t "Secret Service")" "$(t "org.freedesktop.secrets is missing")" \
      "$(t "panod takes its master key from here: sudo apt install -y gnome-keyring  (then log in again)")"
  fi
fi

HELPERS=""
for h in wtype ydotool; do
  has "$h" && HELPERS="$HELPERS $h"
done
if [[ "$SESSION" == "wayland" && "$IS_GNOME" -eq 0 ]]; then
  if [[ -n "$HELPERS" ]]; then
    check OK "$(t "Instant paste helper")" "${HELPERS# }"
  else
    check WARN "$(t "Instant paste helper")" "$(t "no wtype/ydotool")" \
      "$(t "For instant paste on non-GNOME Wayland: sudo apt install -y wtype  (or ydotool)")"
  fi
else
  if [[ -n "$HELPERS" ]]; then
    check INFO "$(t "Instant paste helper")" "$(t "%s installed; not needed in this session (X11: XTEST, GNOME: extension)" "${HELPERS# }")"
  else
    check INFO "$(t "Instant paste helper")" "$(t "no wtype/ydotool; not needed in this session (X11: XTEST, GNOME: extension)")"
  fi
fi

CLIP_TOOLS=""
for tool in xclip wl-copy wl-paste; do
  has "$tool" && CLIP_TOOLS="$CLIP_TOOLS $tool"
done
check INFO "$(t "Clipboard test tools")" "$(t "%s (only for scripts/e2e-test.sh; sudo apt install -y xclip wl-clipboard)" "${CLIP_TOOLS:- $(t "none")}")"

# ----------------------------------------------------------- 6. data/config

section "Data and configuration"

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/panora"
if [[ -d "$DATA_DIR" ]]; then
  DMODE="$(stat -c '%a' "$DATA_DIR" 2>/dev/null || true)"
  DB_INFO=""
  if [[ -f "$DATA_DIR/history.db" ]]; then
    DB_INFO=", history.db $(du -h "$DATA_DIR/history.db" 2>/dev/null | cut -f1)"
  fi
  if [[ "$DMODE" == "700" ]]; then
    check OK "$(t "Data directory")" "$(t "%s (0700%s)" "$DATA_DIR" "$DB_INFO")"
  else
    check WARN "$(t "Data directory")" "$(t "%s mode=%s" "$DATA_DIR" "$DMODE")" "chmod 700 $DATA_DIR"
  fi
else
  check WARN "$(t "Data directory")" "$(t "%s is missing" "$DATA_DIR")" \
    "$(t "panod creates it on first start; if the service never started: systemctl --user restart panod.service")"
fi

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/panora/config.toml"
if [[ -f "$CONFIG" ]]; then
  CMODE="$(stat -c '%a' "$CONFIG" 2>/dev/null || true)"
  if [[ "$CMODE" == "600" || "$CMODE" == "644" || "$CMODE" == "640" ]]; then
    check OK "config.toml" "$(t "%s (%s)" "$CONFIG" "$CMODE")"
  else
    check WARN "config.toml" "$(t "%s mode=%s" "$CONFIG" "$CMODE")" "chmod 600 $CONFIG"
  fi
else
  check INFO "config.toml" "$(t "absent, defaults in use (%s)" "$CONFIG")"
fi

if [[ "$DAEMON_UNUSABLE" -eq 0 ]] && has panora-cli; then
  if RELOAD_OUT="$(with_timeout panora-cli reload 2>&1)"; then
    check OK "$(t "Configuration validity")" "$(t "panora-cli reload succeeded")"
  else
    check ERROR "$(t "Configuration validity")" "${RELOAD_OUT:-$(t "reload failed")}" \
      "$(t "Fix %s (README 'Settings' section) and retry: panora-cli reload" "$CONFIG")"
  fi
else
  check INFO "$(t "Configuration validity")" "$(t "skipped because the daemon is not answering")"
fi

# ----------------------------------------------------------------- summary

if [[ "$JSON" -eq 1 ]]; then
  printf '{"ok":%d,"warnings":%d,"errors":%d,"daemon_usable":%s,"checks":[' \
    "$COUNT_OK" "$COUNT_WARN" "$COUNT_ERR" "$([[ "$DAEMON_UNUSABLE" -eq 0 ]] && printf true || printf false)"
  first=1
  for item in "${JSON_ITEMS[@]}"; do
    [[ "$first" -eq 1 ]] || printf ','
    first=0
    printf '%s' "$item"
  done
  printf ']}\n'
else
  echo
  say "Summary: %s OK, %s WARN, %s ERROR" "$COUNT_OK" "$COUNT_WARN" "$COUNT_ERR"
  if [[ "$DAEMON_UNUSABLE" -eq 1 ]]; then
    say "Result: the daemon is unusable. Run the commands listed on the ERROR lines above."
  else
    say "Result: the daemon is running. End-to-end test: scripts/e2e-test.sh"
  fi
fi

[[ "$DAEMON_UNUSABLE" -eq 0 ]]
